class Node:

    def __init__(self, data):
        self.data = data
        self.next_address = None



        
class LinkedList:
    def __init__(self):
        self.head = None

    #Insert in the beginning
    def intser_at_beginning(self, data):
        new_node = Node(data)

        new_node.next_address= self.head
        self.head= new_node


