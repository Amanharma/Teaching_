row = 1

while(row <= 7):
    

    if(row <=4):
        col = 4

        while(col >= row):
            print("*", end=" ")
            col -= 1

    elif(row > 4):
        col = 1

        while(col <= (row-3)):
            print("*", end=" ")
            col += 1


    row += 1
    print()        





















