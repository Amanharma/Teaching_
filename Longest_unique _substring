str1 = "qwsssqwee"

def searching(li, element):
    i = 0
    while(i<len(li)):
        if(li[i]== element):
            return True
        else: 
            i +=1
    return False            

def main(lis):

    final_str= ""
    counter = 1
    max_counter= 0

    i = 0
    ref_el= lis[i]
    while(i<(len(lis)-1)):
        j= i +1
        while(j< len(lis)):
            if(searching(ref_el, lis[j])):
                break
            else:
                ref_el+= lis[j]
                counter +=1
                j +=1
        if(max_counter<counter):
            max_counter = counter
            counter = 0
            final_str= ref_el
            ref_el = ""
            i+=1

        else:
            i+=1    
    
    return final_str


print(main(str1))    











