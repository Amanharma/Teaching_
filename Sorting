li_1 = [12, 43, 21, 11, 19, 9 , 3, 2, 10]


def bubble_sort(li):

    i = 1
    while(i<len(li)):

        j = 0 
        while(j< len(li)-i):
            if(li[j]> li[j+1]):
                c = li[j]
                li[j]= li[j+1]
                li[j+1]= c
                j+=1
            else: 
                j +=1
                
        i += 1        

    return li
    
print(li_1)    
print(bubble_sort(li= li_1))    
