# --------------------deletion-------------------


def deletion(li, index):
    ref_li = [0] * (len(li)-1)
    
    i=0
    while(i<index):
        ref_li[i] = li[i]
        i += 1

    while(i< len(li)-1):
        ref_li[i] = li[i+1]
        i+= 1
    return ref_li
    

print(deletion(li=l_1, index=0))   


#----------------------searching--------------------



def search(li, element):
    ref_var = element

    i= 0
    while(i<=(len(li)-1)):
        if(ref_var == li[i]):
            return i
            break
        elif(not(ref_var == li[i])):
            i += 1
        else:
            return "The number is not in the list!"                
            
