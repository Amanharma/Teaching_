#-------------------insertion------------------


 def insertion(index, element, li):
     ref_li = [0] * (len(li) +1)

     i = 0
    while(i<index):
        ref_li[i]= li[i]
        i += 1

    ref_li[i] = element

    while(i< len(li)):
        ref_li[i+1]= li[i]
        i += 1
    
    return ref_li    


